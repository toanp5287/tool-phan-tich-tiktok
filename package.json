{
  "name": "tiktok-scraper-ts",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput",
    "dev:run": "node --watch dist/server.js",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --config prisma.v2.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma.v2.config.ts",
    "db:migrate:dev": "prisma migrate dev --config prisma.v2.config.ts",
    "db:status": "prisma migrate status --config prisma.v2.config.ts",
    "db:studio": "prisma studio --config prisma.v2.config.ts",
    "datasets:import": "node ops/import.mjs",
    "datasets:verify": "node ops/verify.mjs",
    "datasets:audit:quality": "node ops/dataset-quality-audit.mjs",
    "datasets:recover-relations": "node ops/recover-relations.mjs",
    "datasets:discover-relations": "node ops/raw-relation-recovery.mjs",
    "test:datasets": "node tests/dataset-api.test.mjs",
    "test:analytics": "node tests/analytics-service.test.mjs",
    "test:simulation": "node tests/simulation-engine.test.mjs",
    "test:deep-analysis": "node tests/product-deep-analysis.test.mjs",
    "test:winning": "node tests/winning-product-finder.test.mjs",
    "test:mi-scoring": "node tests/market-intelligence-scoring.test.mjs",
    "test:mi-api": "node tests/market-intelligence-api.test.mjs",
    "test:dataset-quality-audit": "node tests/dataset-quality-audit.test.mjs",
    "test:openrouter": "node tests/openrouter-provider.test.mjs",
    "test:browser": "node tests/dataset-browser.mjs",
    "db:backfill": "node dist/scripts/backfillCategories.js",
    "db:link-backfill": "node dist/scripts/linkBackfill.js",
    "db:snapshot": "node dist/scripts/snapshotBackfill.js",
    "db:simulate-history": "node dist/scripts/simulateHistory.js",
    "db:simulate-entities": "node dist/scripts/generateSyntheticEntities.js 90",
    "db:sync-categories": "node dist/scripts/syncCategories.js",
    "echotik:sync-shops": "node dist/scripts/syncEchoTikGroup.js shops",
    "echotik:sync-products": "node dist/scripts/syncEchoTikGroup.js products",
    "echotik:sync-trends": "node dist/scripts/syncEchoTikGroup.js trends",
    "echotik:sync-categories": "node dist/scripts/syncEchoTikGroup.js categories",
    "echotik:sync-full": "node dist/scripts/syncEchoTikFullDataset.js",
    "echotik:sync-test": "node dist/scripts/syncEchoTikFullDataset.js --shop-pages 2 --product-pages 2",
    "test:offline": "node ops/verify.mjs && node tests/dataset-api.test.mjs",
    "scrape": "node dist/scripts/scrapeContinuous.js",
    "scrape:once": "node dist/scripts/scrapeOnce.js",
    "scrape:shop": "node dist/scripts/scrapeContinuous.js",
    "scrape:shop:once": "node dist/scripts/scrapeOnce.js"
  },
  "keywords": [
    "tiktok",
    "analytics",
    "scraper",
    "apify",
    "prisma"
  ],
  "author": "",
  "license": "ISC",
  "description": "TikTok E-Commerce Analytics - thu thập và phân tích dữ liệu TikTok Shop",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "playwright": "^1.64.1",
    "prisma": "^7.10.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "apify": "^3.7.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1"
  }
}
