{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "types": ["node"],
    "sourceMap": true,
    "declaration": false,
    "resolveJsonModule": true
  },
    "include": ["src/server.ts", "src/scripts/linkBackfill.ts", "src/scripts/snapshotBackfill.ts", "src/scripts/simulateHistory.ts", "src/scripts/generateSyntheticEntities.ts", "src/services/analyticsService.ts", "src/services/marketIntelligence/marketDiscoveryService.ts"],
  "exclude": ["node_modules", "dist", "public"]
}
