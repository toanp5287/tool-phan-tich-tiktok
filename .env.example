# ==========================================
# CƠ SỞ DỮ LIỆU
# ==========================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/tiktok_analytics?schema=public"

# ==========================================
# ỨNG DỤNG
# ==========================================
PORT=3000
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh
LOG_LEVEL=info

# ==========================================
# APIFY (clockworks/tiktok-scraper)
# ==========================================
APIFY_TOKEN=""
APIFY_TIKTOK_ACTOR="clockworks/tiktok-scraper"
APIFY_RESULTS_PER_PAGE=30
APIFY_TIMEOUT_SECS=900
# APIFY_SEARCH_QUERIES="tiktok shop flash sale,thời trang nam nữ,mỹ phẩm chính hãng,đồ gia dụng hot"

# ==========================================
# TIKTOK SHOP (nguồn dữ liệu độc quyền, thị trường VN)
# ==========================================
# Actor HỖ TRỢ THỊ TRƯỜNG VIỆT NAM (clockworks/tiktok-shop-scraper chỉ hỗ trợ US)
APIFY_SHOP_ACTOR="memo23/tiktok-shop-scraper"
# Từ khoá sản phẩm (chỉ TMĐT, không có nội dung giải trí)
APIFY_SHOP_KEYWORDS="my pham,son moi,thoi trang nu,do gia dung,tai nghe"
# TRẦN CỨNG 30 sản phẩm/lần chạy (không thể vượt — bảo vệ ngân sách Apify)
APIFY_SHOP_MAX_ITEMS_PER_RUN=30
APIFY_SHOP_MONTHLY_RUN_LIMIT=11
# Số sản phẩm mỗi từ khoá (bị ép <= 30)
APIFY_SHOP_PRODUCTS_PER_SEARCH=30
# Số từ khoá gộp vào 1 lần gọi Actor (1 run = chi phí thấp nhất)
APIFY_SHOP_KEYWORDS_PER_RUN=15
# Thị trường Việt Nam
APIFY_SHOP_REGION=VN
# Chỉ lưu item chắc chắn thuộc thị trường VN (currency VND hoặc URL /vn/)
APIFY_SHOP_ALLOW_UNKNOWN_MARKET=false
# Best-sellers thị trường VN (cùng run, không thêm chi phí)
APIFY_SHOP_INCLUDE_BEST_SELLERS=true
APIFY_SHOP_BEST_SELLERS_COUNT=20
# Chi tiết SKU/tồn kho (VN chỉ trả listing row nên mặc định tắt)
APIFY_SHOP_INCLUDE_DETAILS=false
# Video xu hướng: TẮT mặc định vì là Actor run riêng (tốn thêm credit). Max 10.
APIFY_SHOP_TREND_VIDEOS_PER_RUN=0
# Chỉ cào dữ liệu TikTok Shop — tuyệt đối không cào mạng xã hội
SCRAPE_SHOP_ONLY=true
SCRAPE_SHOP_CRON="0 */12 * * *"
SCRAPE_SHOP_ON_STARTUP=false
# Thời gian coi file lock .scrape.lock là rác do crash (ms). Mặc định 2 giờ.
SCRAPE_LOCK_STALE_MS=7200000

# ==========================================
# CREATIVE CENTER (Creators / Affiliates)
# ==========================================
# Actor Creative Center dùng để cào Top Creator/Affiliate
APIFY_CREATIVE_ACTOR="memo23/tiktok-creative-center-scraper"
# Bật cào Creative Center theo lịch (mặc định: tắt)
APIFY_CREATIVE_ENABLED=false
APIFY_CREATOR_SEARCH_ACTOR=clockworks/tiktok-user-search-scraper
# Creator search: $0.006/profile on free plan; max 10 results per shop run.
APIFY_CREATOR_SEARCH_MAX_PROFILES=10
# Lịch cào Creative Center (mặc định: 03:00 hằng ngày)
SCRAPE_CREATIVE_CRON="0 3 * * *"

# ==========================================
# RETRY / CHỐNG CHẶN APIFY
# ==========================================
# Số lần thử tối đa khi lỗi mạng hoặc Actor trả về rỗng (mặc định: 3)
APIFY_MAX_ATTEMPTS=3
# Thời gian chờ tối thiểu / tối đa giữa các lần thử (ms). Backoff tăng dần.
APIFY_RETRY_DELAY_MIN_MS=5000
APIFY_RETRY_DELAY_MAX_MS=10000

# ==========================================
# PIPELINE & LỊCH TỰ ĐỘNG
# ==========================================
SCRAPE_CRON="0 0 * * *"
SCRAPE_SCHEDULER_ENABLED=true
SCRAPE_ON_STARTUP=false
SCRAPE_PLAYWRIGHT_FALLBACK=true
PLAYWRIGHT_HEADLESS=true
SCRAPE_CONCURRENCY=5

# ==========================================
# ECHOTIK (NGUỒN DỮ LIỆU CHÍNH)
# ==========================================
# Bật/tắt EchoTik integration
ECHOTIK_ENABLED=false
# Basic Auth username
ECHOTIK_USERNAME=261106914111795200
# Basic Auth password
ECHOTIK_PASSWORD=713c2911b9f94aabbc02784b29eaa30f
# Base URL của EchoTik API
ECHOTIK_BASE_URL="https://api.echotik.com"
# Region (VN, SG, TH, etc.)
ECHOTIK_REGION=VN
# Language (vi-VN, en-US, etc.)
ECHOTIK_LANGUAGE=vi-VN
# Giới hạn requests/tháng (mặc định: 50)
ECHOTIK_MAX_REQUESTS_PER_MONTH=50
# Timeout cho HTTP request (ms, mặc định: 30000)
ECHOTIK_TIMEOUT=30000
# Số lần retry khi lỗi (mặc định: 3)
ECHOTIK_MAX_ATTEMPTS=3
# Thời gian chờ tối thiểu giữa retry (ms, mặc định: 2000)
ECHOTIK_RETRY_DELAY_MIN_MS=2000
# Thời gian chờ tối đa giữa retry (ms, mặc định: 5000)
ECHOTIK_RETRY_DELAY_MAX_MS=5000

# ==========================================
# PROFILE SCRAPING (Sprint 1 - Targeted Top Shops)
# ==========================================
# Số item tối đa mỗi profile/section (default: 50)
APIFY_PROFILE_RESULTS_PER_PAGE=50
# Số profile tối đa mỗi lần gọi Apify (default: 50)
APIFY_MAX_PROFILES_PER_RUN=50
# Lịch cào theo Targeted Profiles riêng (mặc định: mỗi 6 giờ)
SCRAPE_PROFILE_CRON="0 */6 * * *"
# Cào profile khi khởi động server (default: false)
SCRAPE_PROFILE_ON_STARTUP=false

# ==========================================
# BẢO VỆ ENDPOINT KÍCH HOẠT CÀO THỦ CÔNG (để trống = không yêu cầu token)
# ==========================================
ADMIN_TOKEN=

# ==========================================
# GEMINI AI PRODUCT INTELLIGENCE
# ==========================================
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=nvidia/nemotron-3.5-super-vl:free
GEMINI_BASE_URL="https://openrouter.ai/api/v1"
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_ATTEMPTS=2
GEMINI_RETRY_DELAY_MS=1000
GEMINI_MAX_INPUT_CHARS=120000
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_MAX_ANALYSES_PER_PRODUCT=10
GEMINI_MAX_ANALYSES_PER_DAY=100
GEMINI_INPUT_PRICE_PER_MILLION=0
GEMINI_OUTPUT_PRICE_PER_MILLION=0
